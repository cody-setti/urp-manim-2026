#!/bin/bash
# docker-manim - Render Manim code in a Docker container with GPU-acceleration

# Initialize an empty array for the GPU flags.
GPU_FLAGS=()

# Hardware Detection.
if which nvidia-smi &> /dev/null; then
	# If the NVIDIA smi (System Management Interface) is found, assume NVIDIA.
	GPU_FLAGS=("--gpus" "all")
elif [ -e /dev/dri ]; then
	# If the dri (Direct Rendering Infrastructure) directory exists, assume Intel/AMD.
	GPU_FLAGS=("--device" "/dev/dri")
fi

DOCKER_ARGS=(
	run --interactive --tty --rm

	# Override the container's hardcoded UID 1000 with the host's UID/GID
	--user "$(id --user):$(id --group)"

	# Inject detected hardware flags
	"${GPU_FLAGS[@]}"

	# Mount the current directory
	--volume "$(pwd):/manim"

	# Target image and command
	manimcommunity/manim:stable
    	manim --renderer=opengl --write_to_movie "$@"
)

# Render animation.
docker "${DOCKER_ARGS[@]}"
